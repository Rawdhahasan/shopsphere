# ShopSphere environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your own values:
#
#   cp .env.example .env.local
#
# `.env.local` is ignored by Git. NEVER commit real keys.
#
# Variables starting with NEXT_PUBLIC_ are bundled into browser JavaScript,
# so they must never contain secrets. Everything else stays on the server.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
# The public URL of the site. Used for auth redirects and Stripe return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Dashboard → Project Settings → API Keys) ----------------------
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy "anon" key. Safe for the browser:
# Row-Level Security decides what it can read and write.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET. Secret key (sb_secret_...) or legacy "service_role" key.
# Bypasses Row-Level Security. Server-only — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Stripe (Dashboard → Developers → API keys, TEST MODE) --------------------
# SECRET. Must be a test key (sk_test_... or rk_test_...). Live keys are rejected.
STRIPE_SECRET_KEY=
# SECRET. Webhook signing secret (whsec_...). Locally, `stripe listen` prints it.
STRIPE_WEBHOOK_SECRET=
